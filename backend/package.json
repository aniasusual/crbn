{
  "name": "80degrees-omp-bridge",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup:natives": "bun ../frontend/scripts/ensure-natives.js",
    "predev": "bun ../frontend/scripts/ensure-natives.js",
    "prestart": "bun ../frontend/scripts/ensure-natives.js",
    "prebuild": "bun ../frontend/scripts/ensure-natives.js",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun install --cwd templates/node_react && bun build src/index.ts --target=bun --outdir dist --external omp-legacy-pi-modules"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
