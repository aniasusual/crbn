{
  "name": "frontend",
  "description": "AI-powered autonomous software engineering environment",
  "author": "80degrees <support@80degrees.dev>",
  "version": "0.1.1",
  "type": "module",
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/aniasusual/crbn.git"
  },
  "scripts": {
    "dev:react": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "start": "electron .",
    "build": "vite build",
    "stage:bun": "node scripts/stage-bun.js",
    "build:backend": "cd ../backend && bun run build",
    "build:all": "npm run stage:bun && npm run build:backend && npm run build",
    "pack": "npm run build:all && electron-builder --dir",
    "dist": "npm run build:all && electron-builder --publish never",
    "dist:mac": "npm run build:all && electron-builder --mac --publish never",
    "dist:mac:arm64": "npm run build:all && electron-builder --mac --arm64 --publish never",
    "dist:mac:x64": "npm run build:all && electron-builder --mac --x64 --publish never",
    "dist:mac:all": "npm run build:all && electron-builder --mac --arm64 --x64 --publish never",
    "dist:win": "npm run build:all && electron-builder --win --publish never",
    "dist:linux": "npm run build:all && electron-builder --linux --publish never",
    "dist:all": "npm run build:all && electron-builder -mwl --publish never",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "gsap": "^3.15.0",
    "marked": "^18.0.14",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.80degrees.app",
    "productName": "80degrees",
    "publish": {
      "provider": "github",
      "owner": "aniasusual",
      "repo": "crbn"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      },
      {
        "from": "../backend/dist",
        "to": "backend/dist"
      },
      {
        "from": "../backend/native",
        "to": "backend/native"
      },
      {
        "from": "../backend/templates",
        "to": "backend/templates"
      },
      {
        "from": "../backend/package.json",
        "to": "backend/package.json"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 200
        },
        {
          "x": 410,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "maintainer": "80degrees <support@80degrees.dev>",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
