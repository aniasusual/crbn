    "marked": "^18.0.14",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "electron": "^43.4.0",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  }
}
